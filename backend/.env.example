# Copy to .env for local development — never commit the real .env.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# Comma-separated list of allowed frontend origins for CORS, e.g.
# https://your-app.vercel.app. Defaults to "*" (any origin) if unset —
# fine for local dev, but set explicitly in production.
FRONTEND_ORIGINS=*
